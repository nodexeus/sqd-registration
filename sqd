#!/usr/bin/env bash
# One entry point for bulk_register.py.
#
# If fireblocks.env exists it is loaded and the command is routed through the
# Fireblocks JSON-RPC proxy, which is started and torn down around this run.
# Otherwise the command runs directly and signs with a local credential.
#
#   ./sqd peer_ids.txt --action status
#   ./sqd peer_ids.txt --network tethys --limit 1
#
# Every argument is passed straight through to bulk_register.py.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
py="$here/.venv/bin/python"

if [[ ! -x "$py" ]]; then
  echo "error: $py not found. Create the virtualenv first:" >&2
  echo "         python3.11 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
  exit 2
fi

# Which network, so the proxy can be told the matching chain. Read from the
# same table bulk_register.py uses, so the two cannot drift apart.
network=mainnet
prev=""
for arg in "$@"; do
  [[ "$prev" == "--network" ]] && network="$arg"
  prev="$arg"
done

# Overridable so tests never have to write to the operator's real config.
env_file="${SQD_ENV_FILE:-$here/fireblocks.env}"
if [[ -f "$env_file" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$env_file"
  set +a
fi

# An explicit --signer local means this run uses a key held here, so the proxy
# is not merely unnecessary but wrong: starting it would authenticate to a
# workspace that has nothing to do with the account signing. A single job can
# mix the two — one account in Fireblocks, others held directly — so this is
# per run rather than per configuration.
for arg in "$@"; do
  [[ "$arg" == "--signer=local" ]] && exec "$py" "$here/bulk_register.py" "$@"
done
prev=""
for arg in "$@"; do
  if [[ "$prev" == "--signer" && "$arg" == "local" ]]; then
    exec "$py" "$here/bulk_register.py" "$@"
  fi
  prev="$arg"
done

if [[ -z "${FIREBLOCKS_API_KEY:-}" ]]; then
  exec "$py" "$here/bulk_register.py" "$@"
fi

# Both the chain id and the RPC URL come from the same table the script uses.
# Passing --rpcUrl matters: given only --chainId the proxy picks its own default
# endpoint for that chain, which has been an Ankr URL that now rejects
# unauthenticated requests. Supplying it explicitly also means the proxy and the
# script read the same node.
net_info="$("$py" - "$network" <<'PYEOF'
import sys
from sqdreg.networks import NETWORKS
name = sys.argv[1]
if name not in NETWORKS:
    sys.exit(f"error: unknown --network {name!r}")
print(NETWORKS[name].chain_id, NETWORKS[name].rpc_url)
PYEOF
)"
chain_id="${net_info%% *}"
proxy_rpc_url="${net_info##* }"


# Overridable so the wrapper's argument handling can be tested without a real
# Fireblocks workspace.
proxy="${SQD_PROXY:-$here/node_modules/.bin/fireblocks-json-rpc}"
if [[ ! -x "$proxy" ]]; then
  echo "error: the Fireblocks proxy is not installed. Run:" >&2
  echo "         npm install @fireblocks/fireblocks-json-rpc" >&2
  exit 2
fi

# The proxy is a node script, so without node it dies as "env: node: No such
# file or directory" -- true, but it names neither this tool nor the fix. Say
# it plainly instead: whoever reads this may be forwarding it to someone else
# to interpret.
node_bin="${SQD_NODE:-node}"
if ! command -v "$node_bin" >/dev/null 2>&1; then
  echo "error: Node.js is not installed, and signing through Fireblocks needs it." >&2
  echo "       Install Node 18 or newer from https://nodejs.org/ and try again." >&2
  echo "       Runs that do not use Fireblocks (--signer local) do not need it." >&2
  exit 2
fi
node_major="$("$node_bin" -e 'process.stdout.write(String(process.versions.node.split(".")[0]))' 2>/dev/null || echo 0)"
if [[ ! "$node_major" =~ ^[0-9]+$ ]] || (( node_major < 18 )); then
  echo "error: Node 18 or newer is required, but this is $("$node_bin" --version 2>&1)." >&2
  echo "       Upgrade from https://nodejs.org/ and try again." >&2
  exit 2
fi

# Build the command up rather than conditionally emptying an array: bash 3.2,
# which macOS still ships, treats "${empty[@]}" as an unbound variable
# under `set -u`.
cmd=("$py" "$here/bulk_register.py")

# Only add --signer if the caller did not. Passing it twice is harmless to
# argparse but reads like a bug in the echoed command line.
add_signer=1
for arg in "$@"; do
  [[ "$arg" == "--signer" || "$arg" == --signer=* ]] && add_signer=0
done
[[ "$add_signer" -eq 1 ]] && cmd+=(--signer fireblocks)

exec "$proxy" --chainId "$chain_id" --rpcUrl "$proxy_rpc_url" -- "${cmd[@]}" "$@"
