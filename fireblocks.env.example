# Copy to fireblocks.env and fill in. Its presence is what makes ./sqd route
# through Fireblocks; delete or rename it to go back to local signing.
#
# fireblocks.env is gitignored. The RSA key it points at must never be
# committed or shared.

# The API key UUID from the Fireblocks console (Settings -> Users -> API Users).
FIREBLOCKS_API_KEY=

# Path to the RSA private key generated when that API user was created.
FIREBLOCKS_API_PRIVATE_KEY_PATH=./fireblocks_secret.key

# Which vault accounts to use. Leave this commented out and every vault account
# holding the asset is discovered automatically -- one API call, and accounts
# without the asset are skipped. That is what you want in almost every case.
#
# Set it only to restrict the run to specific accounts. If you do, EVERY id
# listed must exist and hold the asset: one that does not aborts the whole run,
# including the valid accounts beside it. Ids are 0-based and shown in the
# console next to the account name.
#FIREBLOCKS_VAULT_ACCOUNT_IDS=0,1

# Sandbox only. Delete this line entirely for production.
#FIREBLOCKS_API_BASE_URL=https://sandbox-api.fireblocks.io
