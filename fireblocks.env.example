# Copy to fireblocks.env and fill in. Its presence is what makes ./sqd route
# through Fireblocks; delete or rename it to go back to local signing.
#
# fireblocks.env is gitignored. The RSA key it points at must never be
# committed or shared.

# The API key UUID from the Fireblocks console (Settings -> Users -> API Users).
FIREBLOCKS_API_KEY=

# Path to the RSA private key generated when that API user was created.
FIREBLOCKS_API_PRIVATE_KEY_PATH=./fireblocks_secret.key

# Which vault account holds the SQD and the gas. Shown in the console next to
# the account name; the first account is 0, not 1.
FIREBLOCKS_VAULT_ACCOUNT_IDS=0

# Sandbox only. Delete this line entirely for production.
#FIREBLOCKS_API_BASE_URL=https://sandbox-api.fireblocks.io
